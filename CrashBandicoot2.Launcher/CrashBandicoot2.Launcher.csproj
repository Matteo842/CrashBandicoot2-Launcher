    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>CrashBandicoot2</AssemblyName>
    <RootNamespace>CrashBandicoot2.Launcher</RootNamespace>
    <Version>0.1.0</Version>
    <Product>Crash Bandicoot 2: Recompiled</Product>
